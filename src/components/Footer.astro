---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo.svg" alt="Homöopathie Akademie München Logo" class="h-20 w-24" />
          <div>
            <span class="font-semibold text-white">Homöopathie Akademie</span>
            <span class="block text-xs text-gray-400">München</span>
          </div>
        </div>
        <p class="text-sm text-gray-400">
          Effektive Homöopathie-Ausbildung seit 2011. In kleinen Gruppen zur Meisterschaft.
        </p>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold text-white mb-4">Kontakt</h3>
        <address class="not-italic text-sm space-y-2">
          <p>Grimmstr. 1</p>
          <p>80336 München</p>
          <p class="pt-2">
            <a href="tel:+4916098052882" class="hover:text-white transition-colors">
              0160 980 528 82
            </a>
          </p>
          <p>
            <a href="mailto:kontakt@homoeopathie-akademie.com" class="hover:text-white transition-colors">
              kontakt@homoeopathie-akademie.com
            </a>
          </p>
        </address>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-white mb-4">Rechtliches</h3>
        <ul class="text-sm space-y-2">
          <li>
            <a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
          </li>
          <li>
            <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-10 pt-8 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} Homöopathie Akademie München. Alle Rechte vorbehalten.</p>
    </div>
  </div>
</footer>
