---

<section id="kursinhalte" class="py-16 md:py-24 bg-white relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary-200 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Kursinhalte</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">
        Was Du bei uns lernst
      </h2>
      <p class="text-lg text-gray-600">
        Strukturiert, praxisnah und auf Dein Tempo abgestimmt.
      </p>
    </div>

    <!-- Tabs -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex gap-1 p-1.5 rounded-xl bg-gray-100 shadow-sm border border-gray-200" role="tablist">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-tab="grundausbildung"
          class="tab-button px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 bg-primary-600 text-white shadow-sm"
        >
          Grundausbildung
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-tab="fortbildung"
          class="tab-button px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50"
        >
          Fortbildung
        </button>
      </div>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panels">
      <!-- Grundausbildung Panel -->
      <div id="panel-grundausbildung" class="tab-panel" role="tabpanel">
        <div class="grid gap-4">
          {grundausbildung.modules.map((module, index) => (
            <details class="group accordion-item bg-gray-50 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow" data-index={index}>
              <summary class="flex items-center gap-4 p-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                {/* Module Number */}
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center shrink-0">
                  <span class="text-lg font-bold text-primary-700">{module.number}</span>
                </div>

                {/* Title & Subtitle */}
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-gray-900">{module.title}</h3>
                  <p class="text-sm text-gray-500">{module.subtitle}</p>
                </div>

                {/* Arrow */}
                <svg class="w-5 h-5 text-gray-400 transition-transform duration-200 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>

              <div class="px-5 pb-5 pt-2 border-t border-gray-200">
                <p class="text-gray-600 mb-4">{module.description}</p>

                {/* Details/Bullet Points */}
                <ul class="mb-4 space-y-2">
                  {module.details.map((detail) => (
                    <li class="flex items-start gap-2 text-sm text-gray-600">
                      <svg class="w-4 h-4 text-primary-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                      </svg>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-2">
                  {module.topics.map((topic) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary-50 text-primary-700 border border-primary-100">
                      {topic}
                    </span>
                  ))}
                </div>
              </div>
