---

---

<section id="kontakt" class="py-16 md:py-24 bg-gray-900 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-primary-400 font-semibold text-sm uppercase tracking-wider">Kontakt</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-4">
        Starte Deine Homöopathie-Ausbildung
      </h2>
      <p class="text-lg text-gray-300">
        Hast Du Fragen oder möchtest Du Dich anmelden? Wir freuen uns auf Deine Nachricht.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-semibold mb-6">So erreichst Du uns</h3>

          <div class="space-y-6">
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary-600/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h4 class="font-medium text-white mb-1">Adresse</h4>
                <p class="text-gray-300">
                  Homöopathie Akademie München<br />
                  Grimmstr. 1<br />
                  80336 München
                </p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary-600/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h4 class="font-medium text-white mb-1">Telefon</h4>
                <a href="tel:+4916098052882" class="text-gray-300 hover:text-white transition-colors">
                  0160 980 528 82
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary-600/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h4 class="font-medium text-white mb-1">E-Mail</h4>
                <a href="mailto:kontakt@homoeopathie-akademie.com" class="text-gray-300 hover:text-white transition-colors break-all">
                  kontakt@homoeopathie-akademie.com
                </a>
              </div>
            </div>

            <!-- Public Transport -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary-600/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </div>
              <div>
                <h4 class="font-medium text-white mb-1">Anfahrt</h4>
                <p class="text-gray-300">
                  U3 / U6 Poccistraße<br />
                  <span class="text-sm text-gray-400">Nur 3 Stationen vom Hauptbahnhof München</span>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="p-6 rounded-xl bg-primary-600/20 border border-primary-500/30">
          <h4 class="font-semibold text-white mb-2">Bereit loszulegen?</h4>
          <p class="text-sm text-gray-300 mb-4">
            Schreibe uns eine E-Mail oder ruf uns an – wir beraten Dich gerne persönlich und unverbindlich.
          </p>
          <a
            href="mailto:kontakt@homoeopathie-akademie.com?subject=Anfrage%20zur%20Hom%C3%B6opathie-Ausbildung"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
          >
            E-Mail schreiben
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Map Placeholder -->
      <div class="rounded-xl overflow-hidden h-80 md:h-auto md:min-h-[400px] bg-gray-800">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2662.6!2d11.5544!3d48.1271!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479e75f20d76ada5%3A0x1!2sGrimmstra%C3%9Fe%201%2C%2080336%20M%C3%BCnchen!5e0!3m2!1sde!2sde!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Standort Homöopathie Akademie München"
          class="grayscale hover:grayscale-0 transition-all duration-500"
        ></iframe>
      </div>
    </div>
  </div>
</section>
