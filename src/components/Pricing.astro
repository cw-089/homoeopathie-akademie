---

---

<section id="preise" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Investition</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">
        Transparente Kursgebühren
      </h2>
      <p class="text-lg text-gray-600">
        Investiere in Dein Wissen mit flexiblen Zahlungsoptionen.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Regular Pricing -->
      <div class="relative rounded-2xl border border-gray-200 bg-white p-8">
        <div class="mb-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Regulärer Preis</h3>
          <p class="text-sm text-gray-500">Flexible Zahlungsoptionen für Deine Ausbildung</p>
        </div>

        <div class="space-y-4 mb-8">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-gray-900">450 €</span>
            <span class="text-gray-500">/ Monat</span>
          </div>
          <div class="text-gray-500">oder</div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-bold text-gray-700">4.950 €</span>
            <span class="text-gray-500">/ Jahr</span>
          </div>
        </div>

        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Wöchentlicher Unterricht</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Kleine Gruppengrößen</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Tägliche Fragebeantwortung</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Zertifizierter Abschluss</span>
          </li>
        </ul>

        <a
          href="#kontakt"
          class="block w-full text-center px-6 py-3 text-base font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 rounded-xl transition-colors"
        >
          Mehr erfahren
        </a>
      </div>

      <!-- Special Offer -->
      <div class="relative rounded-2xl border-2 border-accent-400 bg-gradient-to-b from-accent-50 to-white p-8">
        <!-- Badge -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-accent-500 text-white text-xs font-semibold shadow-lg">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            Neujahrsangebot 2026
          </span>
        </div>

        <div class="mb-6 pt-4">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Sonderpreis</h3>
          <p class="text-sm text-gray-500">Spare jetzt bei Deiner Anmeldung</p>
        </div>

        <div class="space-y-4 mb-8">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-accent-600">399 €</span>
            <span class="text-gray-500">/ Monat</span>
            <span class="ml-2 text-sm line-through text-gray-400">450 €</span>
          </div>
          <div class="text-gray-500">oder</div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-bold text-accent-600">4.299 €</span>
            <span class="text-gray-500">/ Jahr</span>
            <span class="ml-2 text-sm line-through text-gray-400">4.950 €</span>
          </div>
          <p class="text-sm text-accent-700 font-medium">
            Spare bis zu 651 € bei Jahreszahlung!
          </p>
        </div>

        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Alle regulären Leistungen</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Reduzierte Kursgebühren</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-600">Limitiertes Angebot</span>
          </li>
        </ul>

        <a
          href="#kontakt"
          class="block w-full text-center px-6 py-3 text-base font-semibold text-white bg-accent-500 hover:bg-accent-600 rounded-xl transition-colors shadow-lg shadow-accent-500/25"
        >
          Jetzt Angebot sichern
        </a>
      </div>
    </div>

    <!-- Private Lessons Note -->
    <div class="mt-12 text-center">
      <p class="text-gray-600">
        <strong>Privatunterricht</strong> ist auf Anfrage ebenfalls möglich.
        <a href="#kontakt" class="text-primary-600 hover:text-primary-700 font-medium underline">Kontaktiere uns</a> für ein individuelles Angebot.
      </p>
    </div>

    <!-- Certification Info -->
    <div class="mt-12 p-6 rounded-xl bg-primary-50 border border-primary-100 max-w-3xl mx-auto">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-gray-900 mb-1">Abschluss mit Zertifikat</h4>
          <p class="text-sm text-gray-600">
            Der Abschluss erfolgt mit Zeugnis – entweder durch eine 10-seitige wissenschaftliche Abschlussarbeit
            oder per schriftlichem und mündlichem Test, je nachdem was Dir besser liegt.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
